# Route provider: auto | google | osrm | local
# auto = Google when GOOGLE_MAPS_API_KEY is set, otherwise OSRM, then local fallback.
ROUTE_PROVIDER=auto

# Optional: enable Google Routes API.
# Requires the Routes API enabled in Google Cloud and a billing account.
GOOGLE_MAPS_API_KEY=

# Free public OSRM demo server (no key required, best effort only).
OSRM_BASE_URL=https://router.project-osrm.org

HTTP_TIMEOUT_SECONDS=15

# Map tiles. Default: OpenStreetMap Germany (reachable in more networks).
# Esri alternative (note: some regions lack high-zoom data):
#   MAP_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}
#   MAP_TILE_ATTRIBUTION="Tiles &copy; Esri &mdash; Source: Esri, Maxar, Earthstar Geographics, and the GIS User Community"
MAP_TILE_URL=https://tile.openstreetmap.de/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION='&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
MAP_TILE_MAX_ZOOM=19
